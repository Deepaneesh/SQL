cells:
  - kind: 2
    languageId: sql
    value: "CREATE TABLE IF NOT EXISTS customers (\r

      \    customer_id INTEGER PRIMARY KEY,\r

      \    customer_name TEXT NOT NULL,\r

      \    email TEXT UNIQUE NOT NULL,\r

      \    city TEXT,\r

      \    state TEXT,\r

      \    signup_date DATE\r

      );\r

      \r

      CREATE TABLE IF NOT EXISTS categories (\r

      \    category_id INTEGER PRIMARY KEY,\r

      \    category_name TEXT NOT NULL UNIQUE\r

      );\r

      \r

      CREATE TABLE IF NOT EXISTS products (\r

      \    product_id INTEGER PRIMARY KEY,\r

      \    product_name TEXT NOT NULL,\r

      \    category_id INTEGER NOT NULL,\r

      \    price REAL CHECK (price > 0),\r

      \    stock INTEGER CHECK (stock >= 0),\r

      \    FOREIGN KEY (category_id) REFERENCES categories(category_id)\r

      );\r

      \r

      CREATE TABLE IF NOT EXISTS orders (\r

      \    order_id INTEGER PRIMARY KEY,\r

      \    customer_id INTEGER NOT NULL,\r

      \    order_date DATE NOT NULL,\r

      \    status TEXT NOT NULL\r

      \        CHECK (status IN ('Pending', 'Shipped', 'Delivered',
      'Cancelled')),\r

      \    FOREIGN KEY (customer_id) REFERENCES customers(customer_id)\r

      );\r

      \r

      CREATE TABLE IF NOT EXISTS order_items (\r

      \    order_item_id INTEGER PRIMARY KEY,\r

      \    order_id INTEGER NOT NULL,\r

      \    product_id INTEGER NOT NULL,\r

      \    quantity INTEGER NOT NULL CHECK (quantity > 0),\r

      \    unit_price REAL NOT NULL CHECK (unit_price > 0),\r

      \    FOREIGN KEY (order_id) REFERENCES orders(order_id),\r

      \    FOREIGN KEY (product_id) REFERENCES products(product_id)\r

      );\r

      \r

      CREATE TABLE IF NOT EXISTS payments (\r

      \    payment_id INTEGER PRIMARY KEY,\r

      \    order_id INTEGER NOT NULL,\r

      \    payment_date DATE,\r

      \    amount REAL CHECK (amount >= 0),\r

      \    payment_method TEXT\r

      \        CHECK (payment_method IN ('UPI', 'Card', 'Net Banking',
      'Cash')),\r

      \    payment_status TEXT\r

      \        CHECK (payment_status IN ('Paid', 'Pending', 'Failed',
      'Refunded')),\r

      \    FOREIGN KEY (order_id) REFERENCES orders(order_id)\r

      );\r\n"
    metadata: {}
